/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# There is no build step and no hashed filenames, so a cached index.html can happily pair itself
# with three-versions-old scripts and fail in ways nobody can debug. Everything the page needs
# is revalidated on every load; ETags keep that a cheap 304.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache

/icon.svg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
